<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <SwitchPreferenceCompat
        android:key="pref_wallpaper_carousel"
        android:title="@string/wallpaper_carousel_title"
        android:summary="@string/wallpaper_carousel_summary"
        android:defaultValue="true"
        android:persistent="true"
        launcher:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="pref_wallpaper_carousel_both_screens"
        android:title="@string/wallpaper_carousel_both_screens_title"
        android:summary="@string/wallpaper_carousel_both_screens_summary"
        android:defaultValue="true"
        android:persistent="true"
        android:dependency="pref_wallpaper_carousel"
        launcher:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="pref_fixed_landscape_mode"
        android:title="@string/landscape_mode_title"
        android:summary="@string/landscape_mode_desc"
        android:defaultValue="false"
        android:persistent="true"
        launcher:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="pref_navbar_burn_in_protection"
        android:title="@string/navbar_burn_in_protection_title"
        android:summary="@string/navbar_burn_in_protection_summary"
        android:defaultValue="true"
        android:persistent="true"
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_navbar_burn_in_interval"
        android:title="@string/navbar_burn_in_interval_title"
        android:persistent="true"
        android:max="300"
        android:defaultValue="60"
        android:dependency="pref_navbar_burn_in_protection"
        settings:min="15"
        settings:units="s"
        launcher:iconSpaceReserved="false" />

    <PreferenceCategory
        android:key="pref_qsb_category"
        android:title="@string/qsb_category_title"
        launcher:iconSpaceReserved="false">

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_qsb_height"
            android:title="@string/qsb_height_title"
            android:persistent="true"
            android:max="72"
            android:defaultValue="63"
            settings:min="40"
            settings:units="dp"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_qsb_width"
            android:title="@string/qsb_width_title"
            android:persistent="true"
            android:max="100"
            android:defaultValue="100"
            settings:min="50"
            settings:units="%"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_qsb_offset_y"
            android:title="@string/qsb_offset_y_title"
            android:summary="@string/qsb_offset_y_summary"
            android:persistent="true"
            android:max="48"
            android:defaultValue="0"
            settings:min="-48"
            settings:units="dp"
            launcher:iconSpaceReserved="false" />

        <ListPreference
            android:key="pref_qsb_align"
            android:title="@string/qsb_align_title"
            android:summary="%s"
            android:entries="@array/qsb_align_entries"
            android:entryValues="@array/qsb_align_values"
            android:defaultValue="center"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_qsb_radius"
            android:title="@string/qsb_radius_title"
            android:persistent="true"
            android:max="100"
            android:defaultValue="100"
            settings:min="0"
            settings:units="%"
            launcher:iconSpaceReserved="false" />

        <Preference
            android:key="pref_qsb_reset"
            android:title="@string/qsb_reset_title"
            launcher:iconSpaceReserved="false" />

    </PreferenceCategory>

    <Preference
        android:key="pref_trust_apps"
        android:title="@string/trust_apps_manager_name" />

    <androidx.preference.PreferenceScreen
        android:persistent="false"
        android:title="@string/suggestion_pref_screen_title"
        android:key="pref_suggestions"
        android:summary="@string/suggestion_pref_screen_desc">
        <intent android:action="android.settings.ACTION_CONTENT_SUGGESTIONS_SETTINGS" />
    </androidx.preference.PreferenceScreen>

    <SwitchPreferenceCompat
        android:key="pref_blur_background_at_app_launch"
        android:title="@string/pref_blur_background_at_app_launch_title"
        android:summary="@string/pref_blur_background_at_app_launch_summary"
        android:defaultValue="true"
        android:persistent="true"
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preference.RestartPreference
        android:key="pref_restart"
        android:title="@string/pref_restart_title"
        android:summary="@string/pref_restart_summary" />

</androidx.preference.PreferenceScreen>

